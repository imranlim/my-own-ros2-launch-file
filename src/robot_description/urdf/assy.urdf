<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myfirst">

  <!-- 1. Include semua fail URDF -->
  <xacro:include filename="$(find robot_description)/urdf/wheel_right.urdf" />
  <xacro:include filename="$(find robot_description)/urdf/wheel_left.urdf" />
  <xacro:include filename="$(find robot_description)/urdf/body.urdf" />
  <xacro:include filename="$(find robot_description)/urdf/shaft.urdf" />
  <xacro:include filename="$(find robot_description)/urdf/caster.urdf" />



  <!-- 3. Sambungkan semua part guna <joint> -->

  <!-- Joint Tayar Kanan -->
  <joint name="base_to_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="-1.3 -1.1 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Joint Tayar Kiri -->
  <joint name="base_to_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="-1.3 1.1 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Joint Shaft -->
  <joint name="base_to_shaft" type="fixed">
    <parent link="base_link"/>
    <child link="shaft_link"/>
    <origin xyz="1.3 0 -0.35" rpy="0 0 0"/>
  </joint>

  <!-- Joint Caster -->
  <joint name="shaft_to_caster" type="fixed">
    <parent link="shaft_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.07 0 -0.15" rpy="0 0 0"/>
  </joint>



<!-- TAMBAH UNTUK ros2_control -->

<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <joint name="base_to_right_wheel">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
  </joint>

  <joint name="base_to_left_wheel">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
  </joint>
</ros2_control>
 



<!-- TAMBAH UNTUK GAZEBO -->

<gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find robot_simulation)/config/diffdrive.yaml</parameters>
      <ros>
        <remapping>/diff_drive_base_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
      </ros>
    </plugin>
</gazebo>





</robot>