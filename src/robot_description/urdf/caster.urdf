<?xml version="1.0"?>
<robot name="caster">
  <link name="caster_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 1.5708 1.5708"/>
      <mass value="0.5"/>
      <inertia ixx="0.0032" ixy="0.0" ixz="0.0" iyy="0.0032" iyz="0.0" izz="0.0056"/>
    </inertial>


    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 1.5708"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </visual>



    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 1.5708"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

  </link>

<gazebo reference="caster_link">
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>
  
</robot>
